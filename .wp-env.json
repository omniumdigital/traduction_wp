{
  "$schema": "https://schemas.wp.org/trunk/wp-env.json",
  "phpVersion": "8.1",
  "plugins": [],
  "port": 8881,
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_LOG": true,
    "SCRIPT_DEBUG": true,
    "WP_MEMORY_LIMIT": "512M",
    "WP_MAX_MEMORY_LIMIT": "512M"
  },
  "testsEnvironment": false,
  "mappings": {
    "wp-content/plugins/omnium-translate": ".",
    "wp-content/mu-plugins/omtr-mock-provider.php": "./env/recette/mock-provider.php"
  },
  "lifecycleScripts": {
    "afterStart": "npx wp-env run cli wp plugin activate omnium-translate"
  }
}
