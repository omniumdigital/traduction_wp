{
  "$schema": "https://schemas.wp.org/trunk/wp-env.json",
  "phpVersion": "8.1",
  "plugins": [
    "./oxygen",
    "https://downloads.wordpress.org/plugin/woocommerce.zip",
    "https://downloads.wordpress.org/plugin/seo-by-rank-math.latest-stable.zip"
  ],
  "port": 8883,
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_LOG": true,
    "WP_MEMORY_LIMIT": "512M",
    "WP_MAX_MEMORY_LIMIT": "512M"
  },
  "testsEnvironment": false,
  "mappings": {
    "wp-content/plugins/omnium-translate": "../..",
    "wp-content/mu-plugins/omtr-mock-provider.php": "../recette/mock-provider.php"
  },
  "lifecycleScripts": {
    "afterStart": "npx wp-env run cli wp plugin activate omnium-translate"
  }
}
