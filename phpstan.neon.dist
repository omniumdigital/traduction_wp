parameters:
    level: 6
    paths:
        - omnium-translate.php
        - uninstall.php
        - src
    scanFiles:
        - vendor/woocommerce/action-scheduler/functions.php
        - tests/stubs/dom-html84.stub
        - tests/stubs/wp-cli-utils.stub
        - tests/stubs/elementor.stub
        - tests/stubs/oxygen-runtime.php
    bootstrapFiles:
        - tests/phpstan-bootstrap.php
    ignoreErrors:
        -
            # assets/build/*.asset.php only exists after `npm run build`.
            identifier: require.fileNotFound
            path: src/Admin/Administration.php
            reportUnmatched: false
    dynamicConstantNames:
        - OMTR_ENCRYPTION_KEY
        - OMTR_MIN_PHP
