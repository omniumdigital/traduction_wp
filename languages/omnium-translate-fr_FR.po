msgid ""
msgstr ""
"Project-Id-Version: Omnium Translate\n"
"Language: fr_FR\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "CSV file is not readable."
msgstr "Le fichier CSV n’est pas lisible."

msgid "CSV file exceeds 1 MB."
msgstr "Le fichier CSV dépasse 1 Mo."

msgid "File must use the CSV extension."
msgstr "Le fichier doit utiliser l’extension CSV."

msgid "Invalid CSV MIME type."
msgstr "Le type MIME du CSV est invalide."

msgid "CSV file could not be read."
msgstr "Le fichier CSV n’a pas pu être lu."

msgid "In-memory CSV stream could not be created."
msgstr "Le flux CSV en mémoire n’a pas pu être créé."

msgid "CSV columns must be term,target_lang,translation,rule."
msgstr "Les colonnes CSV doivent être term,target_lang,translation,rule."

msgid "Every CSV row must contain four columns."
msgstr "Chaque ligne CSV doit contenir quatre colonnes."

msgid "Term and target language are required."
msgstr "Le terme et la langue cible sont obligatoires."

msgid "Rule must be translate or keep."
msgstr "La règle doit être translate ou keep."

msgid "Translate rules require a translation."
msgstr "Les règles translate nécessitent une traduction."

msgid "Usage: wp omtr glossary add <term> <target_lang> <translation> <rule>."
msgstr "Utilisation : wp omtr glossary add <term> <target_lang> <translation> <rule>."

msgid "Glossary rule %d added."
msgstr "Règle de glossaire %d ajoutée."

msgid "Provide a glossary rule id."
msgstr "Indiquez l’identifiant d’une règle de glossaire."

msgid "Glossary rule deleted."
msgstr "Règle de glossaire supprimée."

msgid "Provide a CSV file."
msgstr "Indiquez un fichier CSV."

msgid "%d glossary rules imported."
msgstr "%d règles de glossaire importées."

msgid "You need the omtr_manage capability (try --user=admin)."
msgstr "La capacité omtr_manage est requise (essayez --user=admin)."

msgid "Provide a valid CSV file."
msgstr "Fournissez un fichier CSV valide."

msgid "Provide one post id or URL, or use --all."
msgstr "Indiquez un identifiant d’article ou une URL, ou utilisez --all."

msgid "Only a published public post can be estimated."
msgstr "Seul un contenu public publié peut être estimé."

msgid "unknown cost"
msgstr "coût inconnu"

msgid "The estimator is unavailable."
msgstr "L’estimateur est indisponible."

msgid "No published public content was selected."
msgstr "Aucun contenu public publié n’a été sélectionné."

msgid "The translation queue is paused."
msgstr "La file de traduction est en pause."

msgid "Translation queue paused."
msgstr "File de traduction mise en pause."

msgid "Translation queue resumed."
msgstr "File de traduction reprise."

msgid "paused"
msgstr "en pause"

msgid "running"
msgstr "active"

msgid "The translation queue is unavailable."
msgstr "La file de traduction est indisponible."

msgid "Queue the translation of all these pages?"
msgstr "Mettre en file la traduction de toutes ces pages ?"

msgid "Full-site translation queued."
msgstr "Traduction de tout le site mise en file."

msgid "Translate"
msgstr "Traduire"

msgid "You are not allowed to translate this content."
msgstr "Vous n’êtes pas autorisé à traduire ce contenu."

msgid "Only published public content can be translated."
msgstr "Seul un contenu public publié peut être traduit."

msgid "Provide one post id, or use --all."
msgstr "Indiquez un identifiant de contenu, ou utilisez --all."

msgid "%d translated slug(s) generated."
msgstr "%d slug(s) traduit(s) généré(s)."

msgid "Usage: wp omtr slugs set <post_id> <lang> <slug>."
msgstr "Utilisation : wp omtr slugs set <post_id> <lang> <slug>."

msgid "The translated slug is invalid."
msgstr "Le slug traduit est invalide."

msgid "Translated slug set to %s."
msgstr "Slug traduit défini sur %s."

msgid "Language selector"
msgstr "Sélecteur de langue"

msgid "Add to Menu"
msgstr "Ajouter au menu"

msgid "Display links to every configured language."
msgstr "Affiche des liens vers chaque langue configurée."

msgid "Dropdown"
msgstr "Menu déroulant"

msgid "Inline"
msgstr "En ligne"

msgid "Floating"
msgstr "Flottant"

msgid "Flag and name"
msgstr "Drapeau et nom"

msgid "Flag only"
msgstr "Drapeau uniquement"

msgid "Name only"
msgstr "Nom uniquement"

msgid "Language code"
msgstr "Code de langue"

msgid "Layout"
msgstr "Disposition"

msgid "Display"
msgstr "Affichage"

msgid "Switcher settings"
msgstr "Réglages du sélecteur"

msgid "Language links are rendered on the published page."
msgstr "Les liens de langue sont rendus sur la page publiée."

msgid "The administration interface is not built yet."
msgstr "L’interface d’administration n’est pas encore compilée."

msgid "API key is valid."
msgstr "La clé API est valide."

msgid "API key test failed."
msgstr "Le test de la clé API a échoué."

msgid "Configuration exceeds 1 MB."
msgstr "La configuration dépasse 1 Mo."

msgid "Invalid administration data."
msgstr "Les données d’administration sont invalides."

msgid "The provider operation failed."
msgstr "L’opération du fournisseur a échoué."

msgid "the EU"
msgstr "l’UE"

msgid "a country outside the EU"
msgstr "un pays hors de l’UE"

msgid "Omnium Translate sends public page text to %1$s for translation. Processing takes place in %2$s. No visitor account, order or form data is sent."
msgstr "Omnium Translate envoie le texte des pages publiques à %1$s pour traduction. Le traitement a lieu dans %2$s. Aucune donnée de compte visiteur, de commande ou de formulaire n’est envoyée."
